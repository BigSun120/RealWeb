[Unit]
Description=RealWeb database and uploaded files backup
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/realweb
ExecStart=/usr/bin/flock --nonblock /run/realweb-backup.lock /usr/bin/node /opt/realweb/deploy/backup.cjs
TimeoutStartSec=30min
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/backups/realweb-system /run
StandardOutput=journal
StandardError=journal
