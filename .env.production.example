# 生产环境配置文件
# 部署时将此文件重命名为 .env
# 应用配置
NODE_ENV=production
PORT=8000

# 数据库配置 - 统一使用localhost
MONGODB_URI=mongodb://localhost:27017/personal_website_prod
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change_this_to_strong_random_password
MONGO_DATABASE=personal_website_prod

# JWT密钥（生产环境请使用强密钥）
# 生成方法: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here

# 文件上传路径
UPLOAD_PATH=/var/www/uploads

# 前端URL（用于CORS配置）
FRONTEND_URL=https://your-domain.com

# 数据库备份目录
BACKUP_DIR=/root/backups

# 管理员密码更新控制（生产环境设为false）
FORCE_ADMIN_PASSWORD_UPDATE=false

# 邮件配置（可选）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_AUTH=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com

TEMP_SMTP_HOST=127.0.0.1
TEMP_SMTP_PORT=2500

# 管理员账户配置
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=change_this_password
ADMIN_DISPLAY_NAME=系统管理员
